[app-name="brightness-osd"]
anchor=bottom-center
layer=overlay
width=420
height=44
outer-margin=0,0,36
margin=0
padding=6,14
background-color=#111827F2
text-color=#CDD6F4FF
border-color=#75f1fa
border-size=1
border-radius=14
progress-color=over #75f1fa
default-timeout=1200
text-alignment=center
format=<b>%s</b> %b
max-icon-size=20

[app-name="volume-osd"]
anchor=bottom-center
layer=overlay
width=420
height=44
outer-margin=0,0,36
margin=0
padding=6,14
background-color=#111827F2
text-color=#CDD6F4FF
border-color=#75f1fa
border-size=1
border-radius=14
progress-color=over #75f1fa
default-timeout=1200
text-alignment=center
format=<b>%s</b> %b
max-icon-size=20

# KakaoTalk should only appear when launched manually; discard its popups.
[app-name="KakaoTalk"]
invisible=1
history=0

[app-name="KakaoTalk(32-bit)"]
invisible=1
history=0

# Waybar toggles this mode to silence notification popups without disabling
# notification history.  Click the notification icon again to restore them.
[mode=do-not-disturb]
invisible=1

# Keep hardware feedback visible even while normal notifications are muted.
[app-name="brightness-osd" mode=do-not-disturb]
invisible=0

[app-name="volume-osd" mode=do-not-disturb]
invisible=0
